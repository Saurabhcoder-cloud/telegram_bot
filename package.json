{
  "name": "tax-assistant-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "lint": "eslint .",
    "test": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "eslint": "^9.11.1",
    "eslint-config-next": "^14.2.12",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^1.6.0"
  }
}
